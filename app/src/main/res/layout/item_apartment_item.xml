<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/shape_rv_search_home_style"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    tools:ignore="RtlSymmetry">
    
    <ImageView
        android:id="@+id/room_img"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center" />
    
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">
        
        <TextView
            android:id="@+id/room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_rv_room_default"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
        
        <TextView
            android:id="@+id/room_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_rv_region_default"
            android:layout_marginTop="25dp"
            android:textColor="#BFAEA5"
            android:textSize="13sp" />
        
        <TextView
            android:id="@+id/room_history_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_rv_time_default"
            android:layout_marginTop="50dp"
            android:textColor="#BFAEA5"
            android:visibility="gone"
            android:textSize="13sp" />
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/item_apartment_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone"/>
        
        <TextView
            android:id="@+id/search_item_room_rent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/search_rv_rent_default"
            android:layout_gravity="bottom"
            android:textColor="@color/red"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>
    
</LinearLayout>