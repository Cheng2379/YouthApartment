<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LoginActivity">
    
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="100dp"
        android:src="@drawable/user" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="40dp"
        android:orientation="vertical">
        
        <EditText
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@null"
            android:hint="请输入手机号"
            android:inputType="number" />
        
        <TextView
            android:id="@+id/hidePhoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请填写正确的手机号"
            android:textColor="@color/red"
            android:visibility="gone" />
        
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:background="#C5C5C7" />
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            
            <EditText
                android:id="@+id/captcha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:background="@null"
                android:hint="请输入验证码"
                android:inputType="number" />
            
            <Button
                android:id="@+id/sendCaptcha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@drawable/selector_btn_login_press"
                android:text="发送验证码"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>
        
        
        <TextView
            android:id="@+id/hideCaptchaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请填写正确的验证码"
            android:textColor="@color/red"
            android:visibility="gone" />
    </LinearLayout>
    
    <Button
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/selector_btn_login_press"
        android:text="登录"
        android:textColor="@color/white"
        android:textSize="18dp" />


</LinearLayout>