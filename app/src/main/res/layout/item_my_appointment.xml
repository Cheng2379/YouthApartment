<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20sp"
    android:layout_marginBottom="10sp"
    android:background="@drawable/shape_rv_search_home_style"
    android:elevation="2sp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp">
    
    <ImageView
        android:id="@+id/my_appoint_img"
        android:layout_width="100sp"
        android:layout_height="100sp"
        android:layout_gravity="center"
        android:layout_marginVertical="20dp" />
    
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">
        
        <TextView
            android:id="@+id/my_appoint_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_appointment_default_name"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
        
        <TextView
            android:id="@+id/my_appoint_label"
            style="@style/TextStatusStyle"
            android:layout_gravity="center_vertical"
            android:background="@drawable/shape_status_green"
            android:text="@string/my_appointment_default_label" />
        
        <TextView
            android:id="@+id/my_appoint_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="@string/my_appointment_default_time"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>