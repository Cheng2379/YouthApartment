<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_body"
    android:orientation="vertical">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/home_top_filter_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">
        
        <LinearLayout
            android:id="@+id/search_region"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/search_region_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="地区"
                android:textColor="@color/icon_or_text"
                android:textSize="15sp" />
            
            <ImageView
                android:id="@+id/search_region_img"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/img_drop_down"
                android:backgroundTint="@color/filter_icon" />
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/search_price"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/search_price_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="价格"
                android:textColor="@color/icon_or_text"
                android:textSize="15sp" />
            
            <ImageView
                android:id="@+id/search_price_img"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/img_drop_down"
                android:backgroundTint="@color/filter_icon" />
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/search_pay_type"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/search_pay_type_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="付款方式"
                android:textColor="@color/icon_or_text"
                android:textSize="15sp" />
            
            <ImageView
                android:id="@+id/search_pay_type_img"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/img_drop_down"
                android:backgroundTint="@color/filter_icon" />
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/search_sort"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/search_sort_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="排序"
                android:textColor="@color/icon_or_text"
                android:textSize="15sp" />
            
            <ImageView
                android:id="@+id/search_sort_img"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/img_drop_down"
                android:backgroundTint="@color/filter_icon" />
        </LinearLayout>
    
    </LinearLayout>
    
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/search_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10">
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_rv_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    
    <TextView
        android:id="@+id/search_data_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无数据"
        android:textColor="#B3A09B"
        android:textSize="20sp"
        android:visibility="gone" />


</LinearLayout>