<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="30dp"
        android:background="#E0EBD0"
        android:gravity="center"
        android:orientation="vertical">
        
        <ImageView
            android:id="@+id/user_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/img_user_center" />
        
        <TextView
            android:id="@+id/user_name"
            style="@style/UserCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户—xxxx"
            android:textSize="18sp" />
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        
        <LinearLayout
            android:id="@+id/browse_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/img_browse_history" />
            
            <TextView
                style="@style/UserCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="浏览历史" />
        </LinearLayout>
        
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        
        <LinearLayout
            android:id="@+id/my_reserve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/img_my_reserve" />
            
            <TextView
                style="@style/UserCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的预约" />
        </LinearLayout>
        
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        
        <LinearLayout
            android:id="@+id/my_lease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/img_my_lease" />
            
            <TextView
                style="@style/UserCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的租约" />
        </LinearLayout>
    </LinearLayout>
    
    
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
    
    <Button
        android:id="@+id/exit_login"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/selector_btn_login_press"
        android:text="@string/exit_login_btn"
        android:textColor="@color/white"
        android:textSize="18dp" />

</LinearLayout>