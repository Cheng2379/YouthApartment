<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    
    <!-- 白天黑夜模式切换按钮 -->
    <ImageView
        android:id="@+id/switch_theme_model"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="right"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/svg_dark"
        android:backgroundTint="@color/icon_or_text"
        tools:ignore="RtlHardcoded" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="10dp"
        android:background="@color/home_user_center_bg"
        android:gravity="center"
        android:orientation="vertical">
        
        <ImageView
            android:id="@+id/user_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/img_user_center"
            android:backgroundTint="@color/icon_or_text" />
        
        <TextView
            android:id="@+id/user_name"
            style="@style/UserCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户—xxxx"
            android:textColor="@color/icon_or_text"
            android:textSize="18sp" />
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        
        <LinearLayout
            android:id="@+id/user_center_browse_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/img_browse_history"
                android:backgroundTint="@color/icon_or_text" />
            
            <TextView
                style="@style/UserCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="浏览历史"
                android:textColor="@color/icon_or_text" />
        </LinearLayout>
        
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        
        <LinearLayout
            android:id="@+id/user_center_my_reserve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/img_my_reserve"
                android:backgroundTint="@color/icon_or_text" />
            
            <TextView
                style="@style/UserCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="我的预约"
                android:textColor="@color/icon_or_text" />
        </LinearLayout>
        
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        
        <LinearLayout
            android:id="@+id/user_center_my_lease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/img_my_lease"
                android:backgroundTint="@color/icon_or_text" />
            
            <TextView
                style="@style/UserCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="我的租约"
                android:textColor="@color/icon_or_text" />
        </LinearLayout>
    </LinearLayout>
    
    
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
    
    <Button
        android:id="@+id/user_center_exit_login"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/selector_btn_login"
        android:text="@string/exit_login_btn"
        android:textColor="@color/white"
        android:textSize="18dp" />

</LinearLayout>