<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <style name="UserCenter" parent="android:Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    
    <style name="LabelInfoStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_room_label</item>
        <item name="android:textColor">#4C7846</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    
    <style name="AppointInfoTextKey" parent="android:Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    
    <style name="AppointInfoEditValue" parent="android:Widget.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:textColor">#505052</item>
        <item name="android:background">@color/transparent</item>
    </style>
    
    <style name="DividingLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:alpha">0.5</item>
        <item name="android:background">#232325</item>
    </style>
    
    <!-- 待看房, 状态1 -->
    <style name="MyAppointmentLabelStatusOne" parent="android:Widget.TextView">
        <item name="android:text">待看房</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/shape_appoint_status_green</item>
    </style>
    <!-- 已带看, 状态2 -->
    <style name="MyAppointmentLabelStatusSecond" parent="android:Widget.TextView">
        <item name="android:text">已看房</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/shape_appoint_status_grey</item>
    </style>
    <!-- 已取消, 状态3 -->
    <style name="MyAppointmentLabelStatusThree" parent="android:Widget.TextView">
        <item name="android:text">已取消</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/shape_appoint_status_grey</item>
    </style>
</resources>